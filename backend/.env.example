# Copia este archivo como ".env" y cambia los valores. NUNCA subas el .env a git.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# (la contraseña es la que pusiste al instalar PostgreSQL)
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/pilas

# En Railway se pone "true" (la base exige conexión cifrada)
DATABASE_SSL=false

# Dirección del frontend (para CORS y Socket.IO). Varias separadas por coma.
FRONTEND_URL=http://localhost:5173

# Carpeta donde se guardan las fotos en desarrollo
UPLOAD_DIR=uploads

# Dirección pública del backend (para armar los links de las fotos)
PUBLIC_URL=http://localhost:3000

# IA con Google Gemini (opcional). Crea la llave gratis en https://aistudio.google.com/apikey
# Si la dejas vacía, la app usa reglas de respaldo (palabras clave).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Llave secreta para firmar los tokens JWT (mínimo 32 caracteres, aleatoria).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_DURACION=8h

# Horas sin actividad para cerrar un evento automáticamente
CIERRE_AUTOMATICO_HORAS=6
